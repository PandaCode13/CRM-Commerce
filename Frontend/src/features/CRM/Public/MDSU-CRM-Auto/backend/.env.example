# MDSU CRM Auto - API backend - template
NODE_ENV=development
HOST=0.0.0.0
PORT=8401
API_PREFIX=/api
LOG_LEVEL=debug

DB_URL=postgresql://mdsu:fake_password_change_me@localhost:8402/mdsu_auto
DB_HOST=localhost
DB_PORT=8402
DB_NAME=mdsu_auto
DB_USER=mdsu
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_LOG_QUERIES=false

# --- Cache / Redis -------------------------------------------------
# Redis non utilise par ce CRM

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:8400
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10