# MDSU CRM B2B - API backend - template
NODE_ENV=development
HOST=0.0.0.0
PORT=8601
API_PREFIX=/api
LOG_LEVEL=debug

DB_URL=postgresql://mdsu:fake_password_change_me@localhost:8602/mdsu_b2b
DB_HOST=localhost
DB_PORT=8602
DB_NAME=mdsu_b2b
DB_USER=mdsu
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_LOG_QUERIES=false

# --- Cache / Redis -----------------------------------------------------
REDIS_URL=redis://localhost:8603
REDIS_HOST=localhost
REDIS_PORT=8603
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:8600
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10